{ _allComps.append(new ReducedPPComp(0, "Source PP", enumSynPpRoles.srcPp, 8)) }    // NetStim
{ _allComps.append(new ReducedFakeComp(enumSynPpRoles.netCon, 1)) }
{ _allComps.append(new ReducedPPComp(0, "Target PP", enumSynPpRoles.trgPp, 3)) }    // Exp2Syn
{ _allComps.append(new ReducedPPComp(0, "Single PP", enumSynPpRoles.sngPp, -1)) }

