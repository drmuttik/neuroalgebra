// "Source PP"
proc _addHomogenVarsInfoToSynComp1() { localobj comp, mechStd
    comp = $o1
    
    mechStd = new MechanismStandard("NetStim", 1)    // PARAMETER
    mechStd.set("interval", 100.0)    // (ms)
    mechStd.set("number", 1000.0)
    mechStd.set("start", 2.0)    // (ms)
    mechStd.set("noise", 1.0)
    comp.mechStds[8][0] = mechStd
}

// "NetCon"
proc _addHomogenVarsInfoToSynComp2() { localobj comp, mechStd
    comp = $o1
    
    mechStd = new FakeMechanismStandardForNetCon()
    mechStd.set("threshold", 0.0)    // (mV)
    mechStd.set("delay", 0.0)    // (ms)
    mechStd.set("weight", 0.0002)
    comp.mechStds[1][0] = mechStd
}

// "Target PP"
proc _addHomogenVarsInfoToSynComp3() { localobj comp, mechStd
    comp = $o1
}

// "Single PP"
proc _addHomogenVarsInfoToSynComp4() { localobj comp, mechStd
    comp = $o1
}

_comp = _allComps.o(0)
_addHomogenVarsInfoToSynComp1(_comp)    // "Source PP"

_comp = _allComps.o(1)
_addHomogenVarsInfoToSynComp2(_comp)    // "NetCon"

_comp = _allComps.o(2)
_addHomogenVarsInfoToSynComp3(_comp)    // "Target PP"

_comp = _allComps.o(3)
_addHomogenVarsInfoToSynComp4(_comp)    // "Single PP"

//////////////////// End of syn set #1: Homogen vars /////////////////////

//////////////////// Start of syn set #1: "Import & Edit" measures ///////

