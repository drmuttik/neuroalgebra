// "Soma"
proc _addHomogenVarsInfoToBiophysComp1() { localobj comp, mechStd
    comp = $o1
    
    comp.isMechInserted[0] = 1    // morphology
    comp.isMechInserted[1] = 1    // capacitance
    comp.isMechInserted[2] = 1    // pas
    comp.isMechInserted[8] = 1    // ca_ion
    comp.isMechInserted[23] = 1    // ip3_ion
    comp.isMechInserted[27] = 1    // cadifus
    
    mechStd = new MechanismStandard("morphology", 1)    // PARAMETER
    mechStd.set("diam", 7.22599983215332)    // (um)
    comp.mechStds[0][0] = mechStd
    
    mechStd = new MechanismStandard("capacitance", 1)    // PARAMETER
    mechStd.set("cm", 0.8)    // (uF/cm2)
    comp.mechStds[1][0] = mechStd
    
    mechStd = new MechanismStandard("pas", 1)    // PARAMETER
    mechStd.set("g_pas", 8.968609865470852e-05)    // (S/cm2)
    mechStd.set("e_pas", -85.0)    // (mV)
    comp.mechStds[2][0] = mechStd
}

// "Dendrites"
proc _addHomogenVarsInfoToBiophysComp2() { localobj comp, mechStd
    comp = $o1
    
    comp.isMechInserted[0] = 1    // morphology
    comp.isMechInserted[1] = 1    // capacitance
    comp.isMechInserted[2] = 1    // pas
    comp.isMechInserted[8] = 1    // ca_ion
    comp.isMechInserted[23] = 1    // ip3_ion
    comp.isMechInserted[27] = 1    // cadifus
    
    mechStd = new MechanismStandard("morphology", 1)    // PARAMETER
    mechStd.set("diam", math.nan)
    comp.mechStds[0][0] = mechStd
    
    mechStd = new MechanismStandard("capacitance", 1)    // PARAMETER
    mechStd.set("cm", 0.8)    // (uF/cm2)
    comp.mechStds[1][0] = mechStd
    
    mechStd = new MechanismStandard("pas", 1)    // PARAMETER
    mechStd.set("g_pas", 8.968609865470852e-05)    // (S/cm2)
    mechStd.set("e_pas", -85.0)    // (mV)
    comp.mechStds[2][0] = mechStd
}

// "Small Glia"
proc _addHomogenVarsInfoToBiophysComp3() { localobj comp, mechStd
    comp = $o1
    
    comp.isMechInserted[0] = 1    // morphology
    comp.isMechInserted[1] = 1    // capacitance
    comp.isMechInserted[2] = 1    // pas
    comp.isMechInserted[8] = 1    // ca_ion
    comp.isMechInserted[23] = 1    // ip3_ion
    comp.isMechInserted[27] = 1    // cadifus
    
    mechStd = new MechanismStandard("morphology", 1)    // PARAMETER
    mechStd.set("diam", math.nan)
    comp.mechStds[0][0] = mechStd
    
    mechStd = new MechanismStandard("capacitance", 1)    // PARAMETER
    mechStd.set("cm", 0.8)    // (uF/cm2)
    comp.mechStds[1][0] = mechStd
    
    mechStd = new MechanismStandard("pas", 1)    // PARAMETER
    mechStd.set("e_pas", -85.0)    // (mV)
    comp.mechStds[2][0] = mechStd
}

// "Large Glia"
proc _addHomogenVarsInfoToBiophysComp4() { localobj comp, mechStd
    comp = $o1
    
    comp.isMechInserted[0] = 1    // morphology
    comp.isMechInserted[1] = 1    // capacitance
    comp.isMechInserted[2] = 1    // pas
    comp.isMechInserted[8] = 1    // ca_ion
    comp.isMechInserted[23] = 1    // ip3_ion
    comp.isMechInserted[27] = 1    // cadifus
    
    mechStd = new MechanismStandard("morphology", 1)    // PARAMETER
    mechStd.set("diam", math.nan)
    comp.mechStds[0][0] = mechStd
    
    mechStd = new MechanismStandard("capacitance", 1)    // PARAMETER
    mechStd.set("cm", 0.8)    // (uF/cm2)
    comp.mechStds[1][0] = mechStd
    
    mechStd = new MechanismStandard("pas", 1)    // PARAMETER
    mechStd.set("g_pas", math.nan)
    mechStd.set("e_pas", -85.0)    // (mV)
    comp.mechStds[2][0] = mechStd
}

_comp = mmAllComps.o(0)
_addHomogenVarsInfoToBiophysComp1(_comp)    // "Soma"

_comp = mmAllComps.o(1)
_addHomogenVarsInfoToBiophysComp2(_comp)    // "Dendrites"

_comp = mmAllComps.o(2)
_addHomogenVarsInfoToBiophysComp3(_comp)    // "Small Glia"

_comp = mmAllComps.o(3)
_addHomogenVarsInfoToBiophysComp4(_comp)    // "Large Glia"

for eachItemInList(_comp, mmAllComps) {
    _comp.initHomogenBiophysics()
}

